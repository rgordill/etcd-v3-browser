ARG APP_VERSION=1.0.0
ARG BUILD_DATE
ARG VCS_REF

FROM registry.access.redhat.com/ubi9/nodejs-20:latest AS builder

USER 0

WORKDIR /build

COPY src/frontend/package*.json ./frontend/
RUN cd frontend && npm install

COPY src/frontend/ ./frontend/
RUN cd frontend && npm run build

COPY src/package*.json ./
RUN npm install --omit=dev

FROM registry.access.redhat.com/ubi9/ubi-minimal:latest

ARG APP_VERSION=1.0.0
ARG BUILD_DATE
ARG VCS_REF

LABEL name="etcd-v3-browser" \
      version="${APP_VERSION}" \
      release="1" \
      summary="Web browser for etcd v3 key-value store" \
      description="PatternFly-based web UI for browsing and inspecting etcd v3 clusters with in-memory snapshot loading" \
      maintainer="etcd-v3-browser" \
      vendor="etcd-v3-browser" \
      build-date="${BUILD_DATE}" \
      vcs-ref="${VCS_REF}" \
      io.k8s.description="Web browser for etcd v3 key-value store" \
      io.k8s.display-name="etcd v3 Browser" \
      io.openshift.tags="etcd,browser,patternfly"

RUN microdnf install -y nodejs \
    && microdnf clean all \
    && rm -rf /var/cache/yum

WORKDIR /app

COPY --from=builder --chown=1001:0 /build/node_modules ./node_modules
COPY --from=builder --chown=1001:0 /build/frontend/build ./frontend/build
COPY --chown=1001:0 src/server.js src/config.js src/package.json ./
COPY --chown=1001:0 src/routes/ ./routes/
COPY --chown=1001:0 src/services/ ./services/
COPY --chown=1001:0 src/middleware/ ./middleware/
COPY --chown=1001:0 src/lib/ ./lib/
COPY --chown=1001:0 src/protos/ ./protos/

RUN mkdir -p /tmp/etcd-v3-browser-snapshots && chown 1001:0 /tmp/etcd-v3-browser-snapshots

ENV NODE_ENV=production \
    NODE_TLS_REJECT_UNAUTHORIZED=0

USER 1001
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD node -e "const h=require('http');h.get('http://localhost:3001/readyz',r=>{process.exit(r.statusCode===200?0:1)}).on('error',()=>process.exit(1))"

CMD ["node", "server.js"]
