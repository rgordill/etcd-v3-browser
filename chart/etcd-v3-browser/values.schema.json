{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Configuration for deploying the etcd v3 Browser on Kubernetes or OpenShift",
  "properties": {
    "affinity": {
      "additionalProperties": true,
      "description": "Pod affinity and anti-affinity rules",
      "required": [],
      "title": "affinity",
      "type": "object"
    },
    "etcd": {
      "additionalProperties": false,
      "description": "Backend connection defaults for etcd (optional pre-fill)",
      "properties": {
        "hosts": {
          "description": "Optional ETCD_HOSTS pre-fill for the connection form (empty = UI only)",
          "type": "string"
        },
        "tls": {
          "additionalProperties": false,
          "properties": {
            "caCertKey": {
              "type": "string"
            },
            "clientCertKey": {
              "type": "string"
            },
            "clientKeyKey": {
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "title": "etcd",
      "type": "object"
    },
    "fullnameOverride": {
      "default": "",
      "description": "Override fully qualified application name",
      "title": "fullnameOverride",
      "type": "string"
    },
    "global": {
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name.",
      "required": [],
      "title": "global",
      "type": "object"
    },
    "image": {
      "additionalProperties": false,
      "description": "Container image settings",
      "properties": {
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ],
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      },
      "required": [],
      "title": "image",
      "type": "object"
    },
    "imagePullSecrets": {
      "description": "Image pull secrets for private registries",
      "items": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "title": "imagePullSecrets",
      "type": "array"
    },
    "ingress": {
      "additionalProperties": false,
      "description": "Ingress exposure (OpenShift default uses openshift-default class with edge TLS termination)",
      "properties": {
        "annotations": {
          "additionalProperties": true,
          "required": [],
          "type": "object"
        },
        "className": {
          "description": "Use openshift-default on OpenShift; nginx or your controller class on vanilla Kubernetes",
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "hosts": {
          "items": {
            "properties": {
              "host": {
                "type": "string"
              },
              "paths": {
                "items": {
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "pathType": {
                      "enum": [
                        "Prefix",
                        "Exact",
                        "ImplementationSpecific"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "pathType"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "host",
              "paths"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "tls": {
          "items": {
            "properties": {
              "hosts": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "secretName": {
                "type": "string"
              }
            },
            "required": [
              "hosts",
              "secretName"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [],
      "title": "ingress",
      "type": "object"
    },
    "nameOverride": {
      "default": "",
      "description": "Override chart name used in labels and resource names",
      "title": "nameOverride",
      "type": "string"
    },
    "nodeSelector": {
      "additionalProperties": true,
      "description": "Node selector for pod scheduling",
      "required": [],
      "title": "nodeSelector",
      "type": "object"
    },
    "openshiftConsole": {
      "additionalProperties": false,
      "description": "OpenShift console dynamic plugin integration",
      "properties": {
        "backendBasePath": {
          "description": "Service path where plugin static assets are served",
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "enabled": {
          "description": "Deploy ConsolePlugin and register with the OpenShift console",
          "type": "boolean"
        },
        "nginxImage": {
          "description": "nginx image for the HTTPS plugin sidecar",
          "type": "string"
        },
        "patcherImage": {
          "description": "Container image with oc and jq for registering the plugin with the console operator",
          "type": "string"
        },
        "pluginName": {
          "description": "ConsolePlugin resource name (must match plugin-manifest.json)",
          "type": "string"
        },
        "pluginPort": {
          "description": "HTTPS port for the nginx plugin sidecar (OpenShift serving cert)",
          "type": "integer"
        }
      },
      "required": [],
      "title": "openshiftConsole",
      "type": "object"
    },
    "podSecurityContext": {
      "additionalProperties": true,
      "description": "Pod-level security context (restricted-v2 SCC compatible — no hardcoded UID/GID\nso OpenShift can assign from the namespace's MustRunAsRange)",
      "properties": {
        "runAsNonRoot": {
          "default": true,
          "title": "runAsNonRoot",
          "type": "boolean"
        },
        "seccompProfile": {
          "additionalProperties": false,
          "properties": {
            "type": {
              "default": "RuntimeDefault",
              "title": "type",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "seccompProfile",
          "type": "object"
        }
      },
      "required": [
        "runAsNonRoot",
        "seccompProfile"
      ],
      "title": "podSecurityContext",
      "type": "object"
    },
    "replicaCount": {
      "default": 1,
      "description": "yaml-language-server: $schema=values.schema.json\nNumber of pod replicas",
      "minimum": 1,
      "title": "replicaCount",
      "type": "integer"
    },
    "resources": {
      "additionalProperties": true,
      "description": "CPU and memory resource requests and limits",
      "properties": {
        "limits": {
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "default": "500m",
              "title": "cpu",
              "type": "string"
            },
            "memory": {
              "default": "256Mi",
              "title": "memory",
              "type": "string"
            }
          },
          "required": [
            "cpu",
            "memory"
          ],
          "title": "limits",
          "type": "object"
        },
        "requests": {
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "default": "100m",
              "title": "cpu",
              "type": "string"
            },
            "memory": {
              "default": "128Mi",
              "title": "memory",
              "type": "string"
            }
          },
          "required": [
            "cpu",
            "memory"
          ],
          "title": "requests",
          "type": "object"
        }
      },
      "required": [
        "limits",
        "requests"
      ],
      "title": "resources",
      "type": "object"
    },
    "securityContext": {
      "additionalProperties": true,
      "description": "Container-level security context (compatible with OpenShift restricted SCC)",
      "properties": {
        "allowPrivilegeEscalation": {
          "default": false,
          "title": "allowPrivilegeEscalation",
          "type": "boolean"
        },
        "capabilities": {
          "additionalProperties": false,
          "properties": {
            "drop": {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  }
                ],
                "required": []
              },
              "title": "drop",
              "type": "array"
            }
          },
          "required": [
            "drop"
          ],
          "title": "capabilities",
          "type": "object"
        },
        "readOnlyRootFilesystem": {
          "default": true,
          "title": "readOnlyRootFilesystem",
          "type": "boolean"
        }
      },
      "required": [
        "allowPrivilegeEscalation",
        "readOnlyRootFilesystem",
        "capabilities"
      ],
      "title": "securityContext",
      "type": "object"
    },
    "service": {
      "additionalProperties": false,
      "description": "Kubernetes Service settings",
      "properties": {
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ],
          "type": "string"
        }
      },
      "required": [],
      "title": "service",
      "type": "object"
    },
    "serviceAccount": {
      "additionalProperties": false,
      "description": "ServiceAccount configuration",
      "properties": {
        "annotations": {
          "additionalProperties": true,
          "required": [],
          "type": "object"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        },
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [],
      "title": "serviceAccount",
      "type": "object"
    },
    "tmp": {
      "additionalProperties": false,
      "description": "Writable /tmp for snapshot uploads and Node.js temp files (required with readOnlyRootFilesystem)",
      "properties": {
        "enabled": {
          "description": "Mount an emptyDir at /tmp for snapshot uploads and Node.js temp files (required with readOnlyRootFilesystem)",
          "type": "boolean"
        },
        "sizeLimit": {
          "description": "Optional emptyDir size limit (e.g. 4Gi)",
          "type": "string"
        }
      },
      "required": [],
      "title": "tmp",
      "type": "object"
    },
    "tolerations": {
      "description": "Pod tolerations",
      "items": {
        "required": []
      },
      "title": "tolerations",
      "type": "array"
    }
  },
  "required": [
    "image"
  ],
  "title": "etcd-v3-browser Helm chart values",
  "type": "object"
}