{
  "name": "etcd-v3-browser-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "dependencies": {
    "@patternfly/patternfly": "~6.4.0",
    "@patternfly/react-code-editor": "~6.4.2",
    "@patternfly/react-core": "~6.4.2",
    "@patternfly/react-icons": "~6.4.0",
    "@patternfly/react-styles": "~6.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "js-yaml": "^4.2.0",
    "monaco-yaml": "^5.5.1",
    "monaco-editor": "^0.51.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-scripts": "5.0.1",
    "typescript": "^5.4.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-app-rewired build",
    "build:plugin": "rm -rf dist-plugin && webpack --config webpack.config.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "consolePlugin": {
    "name": "etcd-v3-browser",
    "version": "0.1.0",
    "displayName": "etcd v3 Browser",
    "description": "Web browser for etcd v3 key-value store",
    "exposedModules": {
      "EtcdBrowserPage": "./EtcdBrowserPlugin"
    },
    "dependencies": {
      "@console/pluginAPI": "*"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^monaco-editor$": "<rootDir>/src/__mocks__/monaco-editor.js",
      "^monaco-yaml$": "<rootDir>/src/__mocks__/monaco-yaml.js"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "nth-check": "^2.1.1",
    "serialize-javascript": "^7.0.5",
    "underscore": "^1.13.8",
    "postcss": "^8.5.15",
    "uuid": "^11.1.1",
    "@tootallnate/once": "^2.0.1",
    "webpack-dev-server": "^4.15.2"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk": "4.22.0",
    "@openshift-console/dynamic-plugin-sdk-webpack": "4.22.0",
    "@types/js-yaml": "^4.0.9",
    "copy-webpack-plugin": "^14.0.0",
    "monaco-editor-webpack-plugin": "^7.1.1",
    "react-app-rewired": "^2.2.1",
    "ts-loader": "^9.6.0",
    "ts-node": "^10.9.2",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  }
}
