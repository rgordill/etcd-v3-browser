{
  "name": "etcd-v3-browser",
  "version": "1.0.0",
  "description": "Web browser for etcd v3 key-value store with PatternFly UI",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:frontend": "cd frontend && npm install && npm run build",
    "dev:server": "node server.js",
    "dev:frontend": "cd frontend && npm start",
    "test": "jest --coverage",
    "test:ci": "jest --ci --coverage --reporters=default --reporters=jest-junit",
    "test:frontend": "cd frontend && npm test -- --watchAll=false --coverage"
  },
  "keywords": [
    "etcd",
    "browser",
    "patternfly"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "cors": "^2.8.5",
    "etcd3": "^1.1.2",
    "express": "^5.2.1",
    "js-yaml": "^4.2.0",
    "multer": "^2.1.1",
    "protobufjs": "^8.5.0"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/frontend/"
    ]
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "supertest": "^7.1.0"
  }
}
